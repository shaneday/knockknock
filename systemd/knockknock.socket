# systemd owns the UDP socket and queues packets between handler invocations.
# Traffic starts one shared service with the socket inherited as fd 3.
# Enable this socket, not the service: systemctl enable --now knockknock.socket

[Unit]
Description=Knockknock UDP socket

[Socket]
# All IPv4 interfaces; no IPv6 listener.
ListenDatagram=0.0.0.0:9999
Service=knockknock.service
# Draining batches reduces churn; no trigger limit may permanently disable knocks.
TriggerLimitIntervalSec=0

[Install]
# Listen at boot without keeping the handler running.
WantedBy=sockets.target
